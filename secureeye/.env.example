# ===================================================================
# SecureEye — Environment Variables
# Copy this file to .env and fill in your values
# ===================================================================

# ----- Supabase -----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----- Backend Server -----
PORT=3000
WS_PORT=3001
JWT_SECRET=your-jwt-secret-min-32-chars
NODE_ENV=development

# ----- Redis (Upstash or local) -----
REDIS_URL=redis://localhost:6379

# ----- Email (Gmail SMTP) -----
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# ----- Optional Phone-call/Webhook Alerts -----
# Generic webhook (Slack/Discord/automation/call bridge)
ALERT_WEBHOOK_URL=

# Twilio voice call (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+10000000000
TWILIO_TO_NUMBER=+10000000000
# TwiML URL that speaks your emergency message
TWILIO_TWIML_URL=
# Cooldown between voice calls in milliseconds
ALERT_CALL_COOLDOWN_MS=120000

# ----- Firebase (Push Notifications) -----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY="your-firebase-private-key"

# ----- Tailscale -----
TAILSCALE_SUBNET=100.64.0.0/10
TAILSCALE_AUTH_KEY=tskey-auth-xxxxx

# ----- Laptop CCTV -----
BACKEND_WS_URL=ws://100.x.x.x:3001/ws
BACKEND_API_URL=http://100.x.x.x:3000/api

# ----- Mobile App (prefix with EXPO_PUBLIC_) -----
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_BACKEND_URL=https://your-backend-public-url.com
